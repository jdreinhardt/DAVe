# Development image — source is bind-mounted at runtime for hot reload.
# node:22-alpine matches the production image; node:sqlite is available.
FROM node:22-alpine
WORKDIR /app

COPY package.json package-lock.json ./
COPY packages/shared/package.json   ./packages/shared/
COPY packages/backend/package.json  ./packages/backend/
COPY packages/frontend/package.json ./packages/frontend/
RUN npm ci

EXPOSE 3000 5173

CMD ["npm", "run", "dev"]

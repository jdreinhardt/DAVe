# Root URL of the CalDAV/CardDAV endpoint (a trailing slash is stripped).
#   Baikal:   https://baikal.example.com/dav.php
#   Radicale: http://radicale.example.com:5232
# The server must use Basic auth — Digest is not supported.
DAV_BASE_URL=https://baikal.example.com/dav.php

# Random secret for encrypting session credentials — generate with:
#   openssl rand -hex 32
SESSION_SECRET=change-me-to-a-random-32-plus-char-secret

# Max inactivity before a session expires (sliding window, default 7 days)
SESSION_TTL_HOURS=168

# Server binding — the port the app itself listens on, container or not.
PORT=3000
BIND_ADDRESS=0.0.0.0

# Docker Compose only: the port published on the host. Defaults to PORT; set it
# only when the published port must differ from the one the app binds.
# HOST_PORT=8080

# Set to 1 when running behind a reverse proxy (nginx, Caddy, Traefik, etc.)
# so secure cookies and X-Forwarded-For headers work correctly.
TRUST_PROXY=0

# ── Sync cache ────────────────────────────────────────────────────────────────

# How often (seconds) the background worker polls the DAV server for changes.
SYNC_INTERVAL_SECONDS=60

# Override the cache DB path; defaults to $DATA_DIR/cache.db.
# CACHE_DB_PATH=/data/cache.db

# Hard cap on cached entries per user (prevents runaway growth).
MAX_CACHED_ENTRIES_PER_USER=10000

# Days a completed task stays in the local cache after its COMPLETED timestamp.
# After this window it is evicted from the cache (still present on the server).
# Must be 1–90.
COMPLETED_TASK_RETENTION_DAYS=7

# How far back (days) the "Search Archived" toggle queries for old completed tasks.
DAV_ARCHIVE_SEARCH_MAX_AGE_DAYS=365

# ── Global search ─────────────────────────────────────────────────────────────

# How many days in each direction (past and future) to search the DAV server for
# calendar events in global search. Larger values return more results but are slower.
EVENT_SEARCH_RANGE_DAYS=60
